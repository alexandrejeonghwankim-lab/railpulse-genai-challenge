# Required for the Groq-backed RailPulse chatbot.
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile when omitted.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional and used only by the one-time Azure export utilities.
# The local Chainlit application does not require Azure SQL.
AZURE_SQL_CONNECTION_STRING=
